// MainWindow.axaml.cs
using Avalonia.Controls;
using Avalonia.Interactivity;

namespace ChooseAWeapon;

public partial class MainWindow : Window
{
    public MainWindow()
    {
        InitializeComponent();
    }

    private void btnFight_Click(object? sender, RoutedEventArgs e)
    {
        string weapon = cmbWeapon.SelectedItem is ComboBoxItem item
            ? item.Content?.ToString() ?? ""
            : "";

        switch (weapon)
        {
            case "Sword":
                lblResult.Text = "⚔️ You attacked with a Sword!";
                break;

            case "Bow":
                lblResult.Text = "🏹 You attacked with a Bow!";
                break;

            case "Magic":
                lblResult.Text = "✨ You cast a Magic Spell!";
                break;

            default:
                lblResult.Text = "Select a weapon first!";
                break;
        }
    }
}

