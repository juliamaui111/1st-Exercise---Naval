// 1. TREASURE HUNT
// MainWindow.axaml
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WhileFormApp.MainWindow"
        Title="Treasure Hunt"
        Width="800"
        Height="500">

    <Canvas>

        <!-- Cute Background -->
        <Image Source="avares://WhileFormApp/Assets/background.jpeg"
               Width="800"
               Height="500"
               Stretch="Fill"/>

        <!-- Game Title -->
        <TextBlock Text="TREASURE HUNT"
                   FontSize="32"
                   FontWeight="Bold"
                   Canvas.Left="285"
                   Canvas.Top="30"/>

        <!-- Character -->
        <Image x:Name="imgCharacter"
               Source="avares://WhileFormApp/Assets/character.png"
               Width="100"
               Height="100"
               Canvas.Left="50"
               Canvas.Top="200"/>

        <!-- Treasure -->
        <Image x:Name="imgTreasure"
               Source="avares://WhileFormApp/Assets/treasure.png"
               Width="80"
               Height="80"
               Canvas.Left="650"
               Canvas.Top="210"/>

        <!-- Status -->
        <TextBlock x:Name="lblStatus"
                   Text="Find the Gem!"
                   FontSize="20"
                   Canvas.Left="320"
                   Canvas.Top="350"/>

        <!-- Start Button -->
        <Button x:Name="btnSTART"
                Content="Start Game"
                Width="180"
                Height="50"
                Canvas.Left="310"
                Canvas.Top="400"
                Click="btnSTART_Click"/>

    </Canvas>

</Window>

// MainWindow.axaml.cs
using Avalonia.Controls;
using Avalonia.Interactivity;
using System.Threading.Tasks;

namespace WhileFormApp;

public partial class MainWindow : Window
{
    public MainWindow()
    {
        InitializeComponent();
    }

    private async void btnSTART_Click(object? sender, RoutedEventArgs e)
    {
        btnSTART.IsEnabled = false;
        lblStatus.Text = "Moving to the treasure...";

        double startX = 50;
        double treasureX = 650;

        double currentX = startX;

        while (currentX < treasureX)
        {
            currentX += 10;

            Canvas.SetLeft(imgCharacter, currentX);

            await Task.Delay(50);
        }

        lblStatus.Text = "You found the Gem!";

        btnSTART.IsEnabled = true;
    }
}

