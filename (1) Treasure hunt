<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GuessSecretNumber.MainWindow"
        Title="Guess the Secret Number"
        Width="600"
        Height="400"
        Background="#FFF4B8">

    <Grid Margin="30">

        <Border Background="#FFFDF5"
                CornerRadius="25"
                Padding="30">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="20">

                <TextBlock Text="GUESS THE SECRET NUMBER"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#6B5635"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Guess a number from 1 to 10!"
                           FontSize="18"
                           Foreground="#806D4A"
                           HorizontalAlignment="Center"/>

                <TextBox x:Name="txtGuess"
                         Width="220"
                         Height="45"
                         FontSize="18"
                         Watermark="Enter your guess"
                         Background="#FFF8D8"
                         Foreground="#5C4825"
                         HorizontalContentAlignment="Center"/>

                <Button x:Name="btnGuess"
                        Content="Guess"
                        Width="180"
                        Height="50"
                        FontSize="18"
                        FontWeight="Bold"
                        Background="#F7D96B"
                        Foreground="#5C4825"
                        BorderBrush="#D9B94A"
                        BorderThickness="2"
                        Click="btnGuess_Click"/>

                <TextBlock x:Name="lblMessage"
                           Text="Make your guess!"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#6B5635"
                           HorizontalAlignment="Center"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>

// MainWindow.axaml.cs
using Avalonia.Controls;
using Avalonia.Interactivity;

namespace GuessSecretNumber;

public partial class MainWindow : Window
{
    private int secretNumber = 7;

    public MainWindow()
    {
        InitializeComponent();
    }

    private void btnGuess_Click(object? sender, RoutedEventArgs e)
    {
        if (int.TryParse(txtGuess.Text, out int guess))
        {
            if (guess < secretNumber)
            {
                lblMessage.Text = "Too low! Try again.";
            }
            else if (guess > secretNumber)
            {
                lblMessage.Text = "Too high! Try again.";
            }
            else
            {
                lblMessage.Text = "Correct! You found the secret number!";
                btnGuess.IsEnabled = false;
            }
        }
        else
        {
            lblMessage.Text = "Please enter a number from 1 to 10.";
        }
    }
}

