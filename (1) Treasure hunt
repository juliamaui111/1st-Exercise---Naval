// MainWindow.axaml
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TreasureHuntScoreCounter.MainWindow"
        Title="Treasure Hunt Score Counter"
        Width="700"
        Height="500"
        Background="#FFF4B8">

    <Grid Margin="30">

        <!-- Main dirty white card -->
        <Border Background="#FFFDF5"
                CornerRadius="25"
                Padding="30">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="18">

                <!-- Title -->
                <TextBlock Text="TREASURE HUNT"
                           FontSize="36"
                           FontWeight="Bold"
                           Foreground="#6B5635"
                           HorizontalAlignment="Center"/>

                <!-- Subtitle -->
                <TextBlock Text="Collect the treasures!"
                           FontSize="20"
