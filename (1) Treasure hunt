// MainWindow.axaml.cs
using Avalonia.Controls;
using Avalonia.Interactivity;

namespace MonsterBattle;

public partial class MainWindow : Window
{
    private int monsterHP = 50;

    public MainWindow()
    {
        InitializeComponent();
    }

    private void btnFight_Click(object? sender, RoutedEventArgs e)
    {
        do
        {
            monsterHP -= 10;
        }
        while (monsterHP > 40);

        if (monsterHP > 0)
        {
            lblResult.Text = "Monster HP: " + monsterHP;
        }
        else
        {
            lblResult.Text = "Monster defeated! You win!";
            btnFight.IsEnabled = false;
        }
    }
}

